{
  "manifest_version": 3,
  "name": "PromptCard — Image to Prompt AI",
  "version": "1.0.0",
  "description": "Analyzes any image on the page and generates a detailed AI prompt to recreate a similar image. Firefox port of PromptCard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "promptcard-firefox@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["messages.js", "analyzer.js", "background.js"] },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptCard",
    "default_icon": { "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["messages.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  }
}
